              "options": "数据覆盖率"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "hidden"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 500
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
