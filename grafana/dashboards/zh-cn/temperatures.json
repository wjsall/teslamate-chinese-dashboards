        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(date, $__interval, NULL),\n  convert_celsius(avg(inside_temp), '$temp_unit') AS \"车内 [°$temp_unit]\",\n  convert_celsius(avg(outside_temp), '$temp_unit') AS \"车外 [°$temp_unit]\",\n  convert_celsius(avg(driver_temp_setting), '$temp_unit') AS \"驾驶位设定温度（记录值） [°$temp_unit]\"\nFROM positions\nWHERE car_id = $car_id\n  AND (inside_temp IS NOT NULL OR outside_temp IS NOT NULL)\n  AND $__timeFilter(date)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "车内与车外温度",
      "type": "timeseries"
