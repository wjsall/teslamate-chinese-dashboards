              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "id": 8,
      "description": "每一天的细线连接当天记录到的最低和最高温度，较粗的柱体显示第15至第85百分位范围，覆盖当天70%的读数。没有记录的日期会留空。\n\n注意：数据不完整的日期（例如只记录了几个小时）只反映实际测到的时段，可能无法代表全天；红线表示当天的数据覆盖率。",
      "options": {
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "colors": {
          "down": "light-purple",
          "flat": "light-purple",
          "up": "light-purple"
        },
        "fields": {
          "close": "第15百分位",
          "high": "最高温",
          "low": "最低温",
          "open": "第85百分位"
        },
        "includeAllFields": true,
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "mode": "candles"
      },
      "pluginVersion": "13.2.1",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH binned AS (\n  SELECT\n    to_timestamp(floor(extract(epoch FROM date) / 900) * 900) AS bin,\n    avg(outside_temp) AS outside_temp\n  FROM positions\n  WHERE car_id = $car_id AND outside_temp IS NOT NULL AND $__timeFilter(date)\n  GROUP BY 1\n)\nSELECT\n  date_trunc('day', bin, '$__timezone') AS time,\n  convert_celsius(max(outside_temp), '$temp_unit') AS \"最高温\",\n  convert_celsius(min(outside_temp), '$temp_unit') AS \"最低温\",\n  convert_celsius(percentile_cont(0.15) WITHIN GROUP (ORDER BY outside_temp::double precision)::numeric, '$temp_unit') AS \"第15百分位\",\n  convert_celsius(percentile_cont(0.85) WITHIN GROUP (ORDER BY outside_temp::double precision)::numeric, '$temp_unit') AS \"第85百分位\",\n  count(*) * 100 / 96 AS \"数据覆盖率\"\nFROM binned\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "每日车外温度范围",
      "type": "candlestick"
    }
  ],
